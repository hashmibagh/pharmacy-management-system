# ------------------------------------------------------------------
# Pharmacy Management System — Backend environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

APP_ENV=production
APP_URL=http://localhost/pharmacy/backend
APP_DEBUG=false

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pharmacy_db
DB_USER=root
DB_PASSWORD=

# Auth
# jwt | session | both
AUTH_MODE=jwt
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ISSUER=pharmacy-api

# Uploads — absolute path preferred; falls back to backend/uploads
UPLOAD_PATH=
UPLOAD_MAX_SIZE_MB=5

# CORS — comma separated origins, or * for development
CORS_ORIGINS=*

# Rate limiting (file based)
RATE_LIMIT_ENABLED=true

# Web Push (VAPID) — optional, pure-PHP implementation, no Firebase
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
