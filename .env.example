# Copy this file to backend/.env and fill in real values. NEVER commit backend/.env.
# The API front controller (backend/index.php) loads backend/.env via Config::load().

APP_ENV=production
APP_URL=http://localhost
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pharmacy
DB_USER=root
DB_PASSWORD=
JWT_SECRET=CHANGE_THIS_SECRET
UPLOAD_PATH=storage/uploads

# --- Additional backend settings ---
# Access token lifetime in seconds (900 = 15 minutes)
JWT_ACCESS_TTL=900
# Refresh token (httpOnly cookie) lifetime in seconds (604800 = 7 days)
JWT_REFRESH_TTL=604800
# Allowed CORS origins, comma-separated. Use exact origins in production, e.g.
# https://pharmacy.example.com. "*" is for local development only.
CORS_ORIGINS=*
# Auth driver
AUTH_MODE=jwt
# PHP default timezone (affects reports, expiry checks, notifications)
APP_TIMEZONE=Asia/Karachi
